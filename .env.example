# ─────────────────────────────────────────────────────────────────────────────
# IngestIO — environment variables
#
# Every service below has a free tier (no credit card required):
#   • Supabase   → https://supabase.com        (Postgres, Auth, Storage)
#   • Upstash    → https://upstash.com         (serverless Redis for BullMQ)
#   • Google AI  → https://aistudio.google.com (Gemini API)
#
# Copy this file to apps/web/.env and apps/worker/.env, then fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Worker + server-side code only. NEVER expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for uploaded documents (auto-created on first upload).
SUPABASE_STORAGE_BUCKET=documents

# ── Upstash Redis (dashboard → your database → Connect) ──────────────────────
# REST API (used by the web app for lightweight calls, optional).
UPSTASH_REDIS_REST_URL=https://YOUR-DB-NAME.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
# Redis protocol URL (rediss:// = TLS). Used by BullMQ via ioredis.
UPSTASH_REDIS_URL=rediss://default:YOUR-PASSWORD@YOUR-DB-NAME.upstash.io

# ── Google Gemini (aistudio.google.com → Get API key) ────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
# Number of jobs each BullMQ worker processes in parallel.
WORKER_CONCURRENCY=4
# HMAC algorithm used to sign webhook payloads.
WEBHOOK_SIGNING_ALGORITHM=sha256
